/**
 * LocalForage 数据存储类
 * 负责与本地存储的交互，提供持久化数据存储服务
 * @module LocalForageDataStore
 */
import localforage from "localforage";

/**
 * 数据库配置常量
 * @constant
 * @type {Object}
 */
const DB_CONFIG = {
  /** 数据库名称 */
  DB_NAME: "AIccounting",
  /** 主存储名称 */
  ENTRIES_STORE: "entries",
  /** 数据库描述 */
  DB_DESCRIPTION: "AI记账助手的本地数据存储"
};

/**
 * LocalForage数据存储类
 * 使用localforage实现本地持久化存储
 * @class
 */
class LocalForageDataStore {
  /**
   * 创建数据存储实例
   * @constructor
   */
  constructor() {
    this.isInitialized = false;
    this.entriesStore = null;
  }

  /**
   * 初始化数据库连接
   * @async
   * @returns {Promise<boolean>} 初始化是否成功
   * @throws {Error} 数据库初始化失败时抛出错误
   */
  async initializeDb() {
    if (this.isInitialized) return true;

    try {
      console.log("初始化 localforage 数据库...");

      // 配置主存储实例
      localforage.config({
        name: DB_CONFIG.DB_NAME,
        storeName: DB_CONFIG.ENTRIES_STORE,
        description: DB_CONFIG.DB_DESCRIPTION
      });

      // 创建单独的存储实例用于账目数据
      this.entriesStore = localforage.createInstance({
        name: DB_CONFIG.DB_NAME,
        storeName: DB_CONFIG.ENTRIES_STORE
      });

      // 测试数据库连接
      await this._testDatabaseConnection();

      console.log("localforage 数据库初始化成功");
      this.isInitialized = true;
      return true;
    } catch (error) {
      console.error("初始化 localforage 数据库错误:", error);
      this.isInitialized = false;
      throw new Error(`数据库初始化失败: ${error.message}`);
    }
  }

  /**
   * 测试数据库连接
   * @private
   * @async
   * @throws {Error} 测试失败时抛出错误
   */
  async _testDatabaseConnection() {
    await this.entriesStore.setItem("__test__", "ok");
    const test = await this.entriesStore.getItem("__test__");
    if (test !== "ok") {
      throw new Error("localforage 实例测试失败");
    }
    await this.entriesStore.removeItem("__test__");
  }

  /**
   * 确保数据库已初始化
   * @private
   * @async
   * @throws {Error} 数据库未初始化时抛出错误
   */
  async _ensureInitialized() {
    if (!this.isInitialized) {
      await this.initializeDb();
    }
    
    if (!this.entriesStore) {
      throw new Error("数据库存储未正确初始化");
    }
  }

  /**
   * 生成唯一ID
   * @private
   * @returns {string} 生成的唯一ID
   */
  _generateId() {
    return Date.now().toString() + Math.random().toString(36).substring(2, 9);
  }

  /**
   * 添加新交易记录
   * @async
   * @param {Object} entry - 交易记录对象
   * @returns {Promise<string|null>} 成功时返回新记录ID，失败时返回null
   */
  async addEntry(entry) {
    try {
      await this._ensureInitialized();

      // 复制并处理输入对象
      const newEntry = { ...entry };
      
      // 添加唯一ID
      const entryId = this._generateId();
      newEntry.id = entryId;
      
      // 确保有日期时间
      if (!newEntry.datetime) {
        const now = new Date();
        newEntry.datetime = now.toISOString().replace('T', ' ').substring(0, 19);
      }

      // 获取现有条目
      let entries = await this.getEntries();
      
      // 添加新条目
      entries.push(newEntry);
      
      // 保存回存储
      await this.entriesStore.setItem('entries', entries);
      
      return entryId;
    } catch (error) {
      console.error("添加记录失败:", error);
      return null;
    }
  }

  /**
   * 获取交易记录
   * @async
   * @param {string} [startDatetime=null] - 起始日期时间筛选
   * @param {string} [endDatetime=null] - 结束日期时间筛选
   * @param {Array<string>} [categories=null] - 类别筛选
   * @param {boolean} [includeIncome=true] - 是否包含收入
   * @param {boolean} [includeExpense=true] - 是否包含支出
   * @returns {Promise<Array>} 交易记录数组
   */
  async getEntries(
    startDatetime = null,
    endDatetime = null,
    categories = null,
    includeIncome = true,
    includeExpense = true
  ) {
    try {
      await this._ensureInitialized();

      // 获取所有条目
      let entries = await this.entriesStore.getItem('entries');
      
      // 如果不存在，初始化为空数组
      if (!entries) {
        entries = [];
        await this.entriesStore.setItem('entries', entries);
        return [];
      }

      // 应用筛选条件
      return entries.filter(entry => {
        // 收入/支出类型筛选
        if (entry.type === 'income' && !includeIncome) return false;
        if (entry.type === 'expense' && !includeExpense) return false;
        
        // 日期筛选
        if (startDatetime && entry.datetime < startDatetime) return false;
        if (endDatetime && entry.datetime > endDatetime) return false;
        
        // 类别筛选
        if (categories && categories.length > 0 && !categories.includes(entry.category)) {
          return false;
        }
        
        return true;
      });
    } catch (error) {
      console.error("获取记录失败:", error);
      return [];
    }
  }

  /**
   * 更新交易记录
   * @async
   * @param {string} entryId - 记录ID
   * @param {Object} updatedData - 更新的数据
   * @returns {Promise<boolean>} 更新是否成功
   */
  async updateEntry(entryId, updatedData) {
    try {
      await this._ensureInitialized();

      // 获取所有条目
      const entries = await this.getEntries();
      
      // 查找指定条目的索引
      const index = entries.findIndex(e => e.id === entryId);
      
      if (index === -1) {
        console.error(`未找到ID为${entryId}的记录`);
        return false;
      }
      
      // 更新条目，保留原ID和未被更新的字段
      entries[index] = {
        ...entries[index],
        ...updatedData,
        id: entryId  // 确保ID不变
      };
      
      // 保存回存储
      await this.entriesStore.setItem('entries', entries);
      
      return true;
    } catch (error) {
      console.error("更新记录失败:", error);
      return false;
    }
  }

  /**
   * 删除交易记录
   * @async
   * @param {string} entryId - 记录ID
   * @returns {Promise<boolean>} 删除是否成功
   */
  async deleteEntry(entryId) {
    try {
      await this._ensureInitialized();

      // 获取所有条目
      const entries = await this.getEntries();
      
      // 过滤掉要删除的条目
      const filteredEntries = entries.filter(e => e.id !== entryId);
      
      // 检查是否找到并删除了条目
      if (filteredEntries.length === entries.length) {
        console.error(`未找到ID为${entryId}的记录`);
        return false;
      }
      
      // 保存回存储
      await this.entriesStore.setItem('entries', filteredEntries);
      
      return true;
    } catch (error) {
      console.error("删除记录失败:", error);
      return false;
    }
  }

  /**
   * 清空所有记录
   * @async
   * @returns {Promise<boolean>} 清空是否成功
   */
  async clearAllEntries() {
    try {
      await this._ensureInitialized();
      
      // 设置为空数组
      await this.entriesStore.setItem('entries', []);
      
      console.log("所有记录已清空");
      return true;
    } catch (error) {
      console.error("清空记录失败:", error);
      return false;
    }
  }
}

export default LocalForageDataStore;
