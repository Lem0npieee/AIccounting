/**
 * API服务类
 * 负责处理应用中的核心业务逻辑和数据操作
 * @module ApiService
 */
import LocalForageDataStore from "./LocalForageDataStore";
import AIAccountant from "./AIAccountant";

/**
 * 单例实例管理
 * @private
 * @type {Object}
 */
const singletons = {
  /** 数据库实例 */
  dbInstance: null,
  /** AI记账助手实例 */
  aiAccountant: null
};

/**
 * 日期工具对象
 * @namespace DateUtils
 */
const DateUtils = {
  /**
   * 解析可选的日期字符串
   * @function
   * @param {string} dateStr - 日期字符串 YYYY-MM-DD 或 YYYY-MM-DD HH:MM:SS
   * @returns {Date|null} 日期对象或null
   * @throws {Error} 当日期格式无效时抛出错误
   */
  parseDateOptional(dateStr) {
    if (!dateStr) {
      return null;
    }
    
    const parsedDate = new Date(dateStr);
    if (isNaN(parsedDate.getTime())) {
      throw new Error("无效的日期格式。请使用 YYYY-MM-DD 或 YYYY-MM-DD HH:MM:SS。");
    }
    
    return parsedDate;
  },
  
  /**
   * 根据时间周期获取时间范围
   * @function
   * @param {string} timePeriodStr - 时间周期字符串
   * @param {string} [referenceDateStr=null] - 参考日期字符串
   * @returns {[Date, Date]} 开始日期和结束日期的数组
   * @throws {Error} 当时间周期不支持时抛出错误
   */
  getTimeRangeFromPeriod(timePeriodStr, referenceDateStr = null) {
    let today = new Date();
    if (referenceDateStr) {
      try {
        today = this.parseDateOptional(referenceDateStr) || today;
      } catch (e) {
        // 忽略错误，使用当前日期
      }
    }

    let startDate = null;
    let endDate = null;

    if (!timePeriodStr) {
      return [null, null];
    }

    const timePeriodLower = timePeriodStr.toLowerCase();

    // 尝试解析为具体日期 YYYY-MM-DD
    if (/^\d{4}-\d{2}-\d{2}$/.test(timePeriodStr)) {
      const dt = new Date(timePeriodStr);
      return [dt, dt];
    }

    // 尝试解析为年月 YYYY-MM
    if (/^\d{4}-\d{2}$/.test(timePeriodStr)) {
      const year = parseInt(timePeriodStr.split("-")[0]);
      const month = parseInt(timePeriodStr.split("-")[1]) - 1; // JavaScript月份从0开始
      startDate = new Date(year, month, 1);
      endDate = new Date(year, month + 1, 0); // 月末日期
      return [startDate, endDate];
    }

    // 尝试解析为年份 YYYY
    if (/^\d{4}$/.test(timePeriodStr)) {
      const year = parseInt(timePeriodStr);
      startDate = new Date(year, 0, 1);
      endDate = new Date(year, 11, 31);
      return [startDate, endDate];
    }

    // 预定义的时间周期
    const timePeriods = {
      "today": () => {
        startDate = endDate = new Date(today);
        return true;
      },
      "今天": () => timePeriods.today(),
      
      "yesterday": () => {
        startDate = endDate = new Date(today);
        startDate.setDate(today.getDate() - 1);
        endDate = new Date(startDate);
        return true;
      },
      "昨天": () => timePeriods.yesterday(),
      
      "this_week": () => {
        startDate = new Date(today);
        startDate.setDate(today.getDate() - today.getDay() + (today.getDay() === 0 ? -6 : 1)); // 从周一开始
        endDate = new Date(startDate);
        endDate.setDate(startDate.getDate() + 6); // 到周日结束
        return true;
      },
      "本周": () => timePeriods.this_week(),
      
      "last_week": () => {
        const endOfLastWeek = new Date(today);
        endOfLastWeek.setDate(today.getDate() - today.getDay() - (today.getDay() === 0 ? 0 : 0));
        startDate = new Date(endOfLastWeek);
        startDate.setDate(endOfLastWeek.getDate() - 6);
        endDate = new Date(endOfLastWeek);
        return true;
      },
      "上周": () => timePeriods.last_week(),
      
      "this_month": () => {
        startDate = new Date(today.getFullYear(), today.getMonth(), 1);
        endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
        return true;
      },
      "本月": () => timePeriods.this_month(),
      
      "last_month": () => {
        const firstDayCurrentMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        endDate = new Date(firstDayCurrentMonth);
        endDate.setDate(endDate.getDate() - 1);
        startDate = new Date(endDate.getFullYear(), endDate.getMonth(), 1);
        return true;
      },
      "上月": () => timePeriods.last_month(),
      
      "this_year": () => {
        startDate = new Date(today.getFullYear(), 0, 1);
        endDate = new Date(today.getFullYear(), 11, 31);
        return true;
      },
      "今年": () => timePeriods.this_year(),
      
      "last_year": () => {
        const lastYearNum = today.getFullYear() - 1;
        startDate = new Date(lastYearNum, 0, 1);
        endDate = new Date(lastYearNum, 11, 31);
        return true;
      },
      "去年": () => timePeriods.last_year()
    };

    // 尝试匹配预定义时间周期
    if (timePeriods[timePeriodLower] && timePeriods[timePeriodLower]()) {
      // 将时间设置为起始日的00:00:00和结束日的23:59:59
      startDate.setHours(0, 0, 0, 0);
      endDate.setHours(23, 59, 59, 999);
      return [startDate, endDate];
    } else {
      throw new Error(`不支持的时间周期字符串: ${timePeriodStr}`);
    }
  },

  /**
   * 格式化日期为数据库查询字符串
   * @function
   * @param {Date} date - 日期对象
   * @returns {string|null} 格式化的日期字符串或null
   */
  formatDateTimeForDb(date) {
    if (!date) return null;
    
    // 使用本地时间而非UTC时间，避免时区问题
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    const hours = String(date.getHours()).padStart(2, "0");
    const minutes = String(date.getMinutes()).padStart(2, "0");
    const seconds = String(date.getSeconds()).padStart(2, "0");
    
    return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
  }
};

/**
 * 获取数据库实例（单例模式）
 * @function
 * @returns {LocalForageDataStore} 初始化后的数据库实例
 */
function getDb() {
  if (!singletons.dbInstance) {
    singletons.dbInstance = new LocalForageDataStore();
    singletons.dbInstance.initializeDb().catch(err => {
      console.error("数据库初始化失败:", err);
    });
  }
  return singletons.dbInstance;
}

/**
 * 获取AI记账助手实例（单例模式）
 * @function
 * @returns {AIAccountant} AI记账助手实例
 */
function getAiAccountant() {
  if (!singletons.aiAccountant) {
    singletons.aiAccountant = new AIAccountant(getDb());
  }
  return singletons.aiAccountant;
}

/**
 * API服务类
 * 处理应用核心业务逻辑
 * @class
 */
class ApiService {
  /**
   * 获取交易详情
   * @async
   * @param {string} entryId - 交易ID
   * @returns {Promise<Object|null>} 交易详情或null
   */
  async getTransactionDetails(entryId) {
    try {
      const db = getDb();
      const allEntries = await db.getEntries();
      return allEntries.find(entry => entry.id === entryId) || null;
    } catch (error) {
      console.error("获取交易详情错误:", error);
      return null;
    }
  }

  /**
   * 获取过滤后的交易列表
   * @async
   * @param {Object} options - 过滤选项
   * @param {string} [options.startDateStr=null] - 开始日期字符串
   * @param {string} [options.endDateStr=null] - 结束日期字符串
   * @param {string} [options.timePeriod=null] - 时间周期
   * @param {string} [options.incomeExpenseType=null] - 收支类型
   * @param {Array<string>} [options.categories=null] - 类别筛选
   * @returns {Promise<Array>} 交易列表
   */
  async getFilteredTransactionList(options = {}) {
    try {
      const {
        startDateStr = null,
        endDateStr = null,
        timePeriod = null,
        incomeExpenseType = null,
        categories = null,
      } = options;

      const db = getDb();

      let sDate = null;
      let eDate = null;

      // 处理时间周期和日期字符串
      if (timePeriod) {
        [sDate, eDate] = DateUtils.getTimeRangeFromPeriod(timePeriod);
      }

      if (startDateStr) {
        sDate = DateUtils.parseDateOptional(startDateStr);
      }
      
      if (endDateStr) {
        eDate = DateUtils.parseDateOptional(endDateStr);
      }

      const startDatetimeQueryStr = sDate ? DateUtils.formatDateTimeForDb(sDate) : null;
      const endDatetimeQueryStr = eDate ? DateUtils.formatDateTimeForDb(eDate) : null;

      // 处理收支类型
      let includeIncomeParam = true;
      let includeExpenseParam = true;
      
      if (incomeExpenseType) {
        const typeNormalized = incomeExpenseType.toLowerCase();
        includeIncomeParam = typeNormalized !== "expense";
        includeExpenseParam = typeNormalized !== "income";
      }

      // 查询数据
      return await db.getEntries(
        startDatetimeQueryStr,
        endDatetimeQueryStr,
        categories,
        includeIncomeParam,
        includeExpenseParam
      );
    } catch (error) {
      console.error("获取过滤交易列表错误:", error);
      return [];
    }
  }

  /**
   * 获取汇总统计数据
   * @async
   * @param {Object} options - 过滤选项
   * @returns {Promise<Object>} 汇总统计数据
   */
  async getSummaryStatistics(options = {}) {
    try {
      const {
        startDateStr = null,
        endDateStr = null,
        timePeriod = null,
        categories = null
      } = options;

      const transactions = await this.getFilteredTransactionList({
        startDateStr,
        endDateStr,
        timePeriod,
        incomeExpenseType: "all",
        categories
      });

      // 初始化统计数据
      let totalIncome = 0.0;
      let totalExpense = 0.0;
      const incomeByCategory = {};
      const expenseByCategory = {};

      // 累计收支数据
      for (const transaction of transactions) {
        const amount = parseFloat(transaction.amount);
        const category = transaction.category || "其他";
        
        if (transaction.type === "income" && amount > 0) {
          totalIncome += amount;
          
          // 按类别统计收入
          incomeByCategory[category] = (incomeByCategory[category] || 0) + amount;
        } else if (transaction.type === "expense" && amount < 0) {
          const absAmount = Math.abs(amount);
          totalExpense += absAmount;
          
          // 按类别统计支出
          expenseByCategory[category] = (expenseByCategory[category] || 0) + absAmount;
        }
      }

      // 计算派生统计数据
      const netIncome = totalIncome - totalExpense;
      const totalFlow = totalIncome + totalExpense;
      
      return {
        total_income: totalIncome,
        total_expense: totalExpense,
        net_income: netIncome,
        total_flow: totalFlow,
        count: transactions.length,
        income_percentage: totalFlow > 0 ? (totalIncome / totalFlow) * 100 : 50,
        expense_percentage: totalFlow > 0 ? (totalExpense / totalFlow) * 100 : 50,
        income_by_category: incomeByCategory,
        expense_by_category: expenseByCategory
      };
    } catch (error) {
      console.error("获取统计数据错误:", error);
      return {
        total_income: 0,
        total_expense: 0,
        net_income: 0,
        total_flow: 0,
        count: 0,
        income_percentage: 50,
        expense_percentage: 50,
        income_by_category: {},
        expense_by_category: {}
      };
    }
  }

  /**
   * 处理聊天消息
   * @async
   * @param {string} message - 用户消息
   * @returns {Promise<Object|string>} 回复内容
   */
  async handleChatMessage(message) {
    try {
      const ai = getAiAccountant();
      return await ai.processUserMessage(message);
    } catch (error) {
      console.error("处理聊天消息错误:", error);
      return "抱歉，处理您的消息时出现了问题。请稍后再试。";
    }
  }

  /**
   * 启动AI助手
   * @async
   * @returns {Promise<Object>} 状态对象
   */
  async startAI() {
    try {
      const ai = getAiAccountant();
      if (ai) {
        return { success: true, message: "AI记账助手已启动" };
      } else {
        return { success: false, message: "AI记账助手启动失败" };
      }
    } catch (error) {
      console.error("AI启动错误:", error);
      return { 
        success: false, 
        message: error.message || "AI启动时发生未知错误", 
        error 
      };
    }
  }

  /**
   * 获取类别分布数据
   * @async
   * @param {Object} options - 过滤选项
   * @returns {Promise<Array>} 类别分布数据
   */
  async getCategoryDistribution(options = {}) {
    try {
      const {
        startDateStr = null,
        endDateStr = null,
        timePeriod = null,
        incomeExpenseFocus = "all",
        parentCategories = null
      } = options;

      const transactions = await this.getFilteredTransactionList({
        startDateStr,
        endDateStr,
        timePeriod,
        incomeExpenseType: incomeExpenseFocus === "all" ? null : incomeExpenseFocus,
        categories: parentCategories
      });

      // 按类别聚合数据
      const categoryData = {};

      for (const transaction of transactions) {
        const amount = Math.abs(parseFloat(transaction.amount));
        const category = transaction.category || "其他";
        const type = transaction.type;

        // 根据incomeExpenseFocus筛选
        if (incomeExpenseFocus !== "all" && incomeExpenseFocus !== type) {
          continue;
        }

        categoryData[category] = (categoryData[category] || 0) + amount;
      }

      // 转换为前端需要的格式并排序
      return Object.entries(categoryData)
        .map(([category, amount]) => ({
          category,
          amount
        }))
        .sort((a, b) => b.amount - a.amount);
    } catch (error) {
      console.error("获取类别分布数据错误:", error);
      return [];
    }
  }

  /**
   * 获取时间序列数据（趋势数据）
   * @async
   * @param {Object} options - 过滤选项
   * @returns {Promise<Array>} 时间序列数据
   */
  async getTimeSeries(options = {}) {
    try {
      const {
        startDateStr = null,
        endDateStr = null,
        incomeExpenseFocus = "net_income", // income, expense, net_income, total_flow
        categories = null,
        timeUnit = "day" // day, week, month, year
      } = options;

      // 解析日期
      const queryStartDate = DateUtils.parseDateOptional(startDateStr);
      const queryEndDate = DateUtils.parseDateOptional(endDateStr);

      if (!queryStartDate || !queryEndDate) {
        throw new Error(`时间序列数据的日期范围无效: ${startDateStr} 到 ${endDateStr}`);
      }

      // 获取交易数据
      const allTransactions = await this.getFilteredTransactionList({
        startDateStr,
        endDateStr,
        incomeExpenseType: "all",
        categories
      });

      // 按日期分组数据处理器
      const groupKeyGenerators = {
        day: (date) => date.toISOString().split("T")[0], // YYYY-MM-DD
        week: (date) => {
          const weekdays = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];
          return weekdays[date.getDay()];
        },
        month: (date) => `${date.getDate()}日`,
        year: (date) => `${date.getMonth() + 1}月`
      };

      // 排序处理器
      const sortHandlers = {
        day: (a, b) => new Date(a.date) - new Date(b.date),
        week: (a, b) => {
          const weekOrder = { 周一: 1, 周二: 2, 周三: 3, 周四: 4, 周五: 5, 周六: 6, 周日: 7 };
          return weekOrder[a.group_key] - weekOrder[b.group_key];
        },
        month: (a, b) => parseInt(a.day) - parseInt(b.day),
        year: (a, b) => {
          const monthOrder = {
            "1月": 1, "2月": 2, "3月": 3, "4月": 4, "5月": 5, "6月": 6,
            "7月": 7, "8月": 8, "9月": 9, "10月": 10, "11月": 11, "12月": 12
          };
          return monthOrder[a.group_key] - monthOrder[b.group_key];
        }
      };

      // 生成分组键
      const getGroupKey = groupKeyGenerators[timeUnit] || groupKeyGenerators.day;
      
      // 按日期分组数据
      const dataByDate = {};

      // 处理每个交易
      for (const transaction of allTransactions) {
        const currentAmount = parseFloat(transaction.amount);
        let itemDatetime;

        // 解析日期时间字符串
        if (typeof transaction.datetime === "string") {
          itemDatetime = new Date(transaction.datetime.replace(" ", "T"));
        } else if (transaction.datetime instanceof Date) {
          itemDatetime = transaction.datetime;
        } else {
          continue; // 跳过无法解析的日期
        }

        // 获取分组键
        const groupKey = getGroupKey(itemDatetime);

        // 初始化分组数据
        if (!dataByDate[groupKey]) {
          dataByDate[groupKey] = {
            income: 0,
            expense: 0,
            net: 0,
            total: 0,
            date: itemDatetime.toISOString().split("T")[0],
            day_of_week: timeUnit === "week" ? groupKey : null,
            day: timeUnit === "month" ? parseInt(groupKey) : null,
            month_of_year: timeUnit === "year" ? groupKey : null,
          };
        }

        // 根据类型聚合数据
        const valueToAggregate = Math.abs(currentAmount);
        
        if (transaction.type === "income") {
          dataByDate[groupKey].income += valueToAggregate;
          dataByDate[groupKey].net += valueToAggregate;
          dataByDate[groupKey].total += valueToAggregate;
        } else if (transaction.type === "expense") {
          dataByDate[groupKey].expense += valueToAggregate;
          dataByDate[groupKey].net -= valueToAggregate;
          dataByDate[groupKey].total += valueToAggregate;
        }
      }

      // 转换为数组格式
      const result = Object.entries(dataByDate).map(([key, data]) => ({
        group_key: key,
        date: data.date,
        income: data.income,
        expense: data.expense,
        net: data.net,
        total: data.total,
        day_of_week: data.day_of_week,
        day: data.day,
        month_of_year: data.month_of_year,
      }));

      // 按适当的顺序排序
      const sortFn = sortHandlers[timeUnit] || sortHandlers.day;
      return result.sort(sortFn);
    } catch (error) {
      console.error("获取时间序列数据错误:", error);
      return [];
    }
  }

  /**
   * 获取图表数据
   * @async
   * @param {Object} filters - 筛选条件
   * @returns {Promise<Object>} 图表数据
   */
  async getChartData(filters = {}) {
    try {
      const {
        startDateStr,
        endDateStr,
        timePeriod,
        chartType = "line",
        timeUnit = "day",
        incomeExpenseFocus = "net_income",
        expenseCategories = [],
        incomeCategories = []
      } = filters;

      // 合并所有筛选类别
      const allFilteredCategories = [...expenseCategories, ...incomeCategories];
      const combinedCategories = allFilteredCategories.length > 0 ? allFilteredCategories : null;

      // 并行获取各种数据以提高性能
      const [
        summaryStats,
        expenseCategoryDistribution,
        incomeCategoryDistribution,
        trendData
      ] = await Promise.all([
        // 1. 汇总统计
        this.getSummaryStatistics({
          startDateStr,
          endDateStr,
          timePeriod,
          categories: combinedCategories
        }),
        
        // 2. 支出分类分布
        this.getCategoryDistribution({
          startDateStr,
          endDateStr,
          timePeriod,
          incomeExpenseFocus: "expense",
          parentCategories: expenseCategories.length > 0 ? expenseCategories : null
        }),
        
        // 3. 收入分类分布
        this.getCategoryDistribution({
          startDateStr,
          endDateStr,
          timePeriod,
          incomeExpenseFocus: "income",
          parentCategories: incomeCategories.length > 0 ? incomeCategories : null
        }),
        
        // 4. 趋势数据
        this.getTimeSeries({
          startDateStr,
          endDateStr,
          incomeExpenseFocus,
          categories: combinedCategories,
          timeUnit
        })
      ]);

      // 返回综合图表数据
      return {
        summaryStats,
        expenseCategoryDistribution,
        incomeCategoryDistribution,
        trendData,
        chartInfo: {
          type: chartType,
          timeUnit,
          focusMetric: incomeExpenseFocus,
          dateRange: {
            start: startDateStr,
            end: endDateStr,
            period: timePeriod
          }
        }
      };
    } catch (error) {
      console.error("获取图表数据出错:", error);
      throw new Error(`获取图表数据失败: ${error.message}`);
    }
  }
}

// 导出单例实例
export default new ApiService();
